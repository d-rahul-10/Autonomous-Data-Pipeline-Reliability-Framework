# Copy to .env in your deployment environment; replace the key with a random 32+ character value.
APP_ENV=production
SECRET_KEY=
# End-to-end deadline for an asynchronous dashboard analysis (30–3600 seconds).
ANALYSIS_TIMEOUT_SECONDS=300

# Optional Google / GitHub sign-in. Configure the callback URLs below in each provider.
# http://127.0.0.1:5000/api/auth/oauth/google/callback
# http://127.0.0.1:5000/api/auth/oauth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Required only when the app is accessed through a public domain or proxy.
OAUTH_REDIRECT_BASE_URL=

# Optional Apache Airflow integration. Leave blank/disabled until deployed.
AIRFLOW_API_URL=https://airflow.example.com
AIRFLOW_API_VERSION=v1
# Airflow 2: basic. Airflow 3: jwt (username/password token exchange) or bearer (pre-issued token).
AIRFLOW_AUTH_TYPE=basic
AIRFLOW_API_USERNAME=
AIRFLOW_API_PASSWORD=
AIRFLOW_API_TOKEN=
# Both allowlists are required before automated retries can run.
AIRFLOW_DAG_ALLOWLIST=
AIRFLOW_TASK_ALLOWLIST=
AIRFLOW_AUTO_RETRY_ENABLED=false
AIRFLOW_MAX_AUTOMATIC_RETRIES=1
AIRFLOW_POLL_SECONDS=60
AIRFLOW_REQUEST_TIMEOUT=10
